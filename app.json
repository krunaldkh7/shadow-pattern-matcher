{
  "expo": {
    "name": "Shadow Pattern Matcher",
    "slug": "shadow-pattern-matcher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourstudio.shadowpatternmatcher",
      "appleTeamId": "F7X54G99TU"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b130d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yourstudio.shadowpatternmatcher",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#d6c0a4"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# expo-gl's GLView extends TextureView (not ExpoView), so Expo's keep rules miss its constructor.\n-keep class expo.modules.gl.** { *; }\n# Room builds databases by reflection (e.g. WorkManager's WorkDatabase_Impl, pulled in by Google Mobile Ads).\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "backgroundColor": "#1b130d",
    "scheme": "shadowpattern",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b9906c95-fae9-4e0e-ae79-065c6be972df"
      },
      "adsConfigUrl": "https://raw.githubusercontent.com/krunaldkh7/shadow-pattern-matcher-config/main/ads.json"
    },
    "owner": "krunaldkh7"
  }
}
